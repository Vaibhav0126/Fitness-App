# Postgres (Neon pooled connection string in production; local Postgres for dev/CI)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/train
# Better Auth: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
# GitHub OAuth app (callback: ${BETTER_AUTH_URL}/api/auth/callback/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Resend (leave empty in dev: emails are logged to the console instead)
RESEND_API_KEY=
EMAIL_FROM="Train <noreply@example.com>"
# Local/CI only: log emails to the console even in a production build. Never set on Vercel.
# ALLOW_CONSOLE_EMAIL=true
# 32 bytes, base64: `openssl rand -base64 32`. Ciphertexts are prefixed with a key id.
ENCRYPTION_KEY=
# Optional: previous key, accepted for decryption during rotation
ENCRYPTION_KEY_PREVIOUS=
# Vercel Cron sends `Authorization: Bearer ${CRON_SECRET}` to /api/cron/daily (≥16 chars: `openssl rand -hex 24`).
# Without it the cron endpoint answers 503.
CRON_SECRET=
# Comma-separated emails allowed to open /app/admin
ADMIN_EMAILS=
# Strava is out of scope for now (see docs/adr/0003-source-adapters-and-strava.md).
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# STRAVA_WEBHOOK_VERIFY_TOKEN=

# Tests only: the console email fallback also appends messages here (Playwright reads it).
# EMAIL_OUTBOX_DIR=.e2e/outbox
